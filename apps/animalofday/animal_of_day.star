def get_day_of_year(t):
    days_in_months = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    year = t.year
    month = t.month
    day = t.day
    is_leap = (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)
    if is_leap:
        days_in_months[1] = 29
    day_of_year = day
    for i in range(month - 1):
        day_of_year = day_of_year + days_in_months[i]
    return day_of_year

def seeded_shuffle(lst, seed):
    """Shuffle a list using a seeded Linear Congruential Generator (LCG).
    Ensures consistent randomization for the same seed (year)."""
    result = list(lst)
    n = len(result)

    # LCG parameters (Numerical Recipes standard values)
    a = 1664525  # multiplier
    c = 1013904223  # increment
    m = 4294967296  # modulus (2^32)
    state = seed
    for i in range(n - 1, 0, -1):
        state = (a * state + c) % m
        j = state % (i + 1)
        temp = result[i]
        result[i] = result[j]
        result[j] = temp
    return result

def get_animal_for_day(day_num, year):
    shuffled = seeded_shuffle(ANIMALS, year)

    # Handle leap year: clamp day 366 to 365 to avoid duplicate
    if day_num > 365:
        day_num = 365
    index = (day_num - 1) % len(shuffled)
    return shuffled[index]

def is_reveal_time(hour):
    return hour >= REVEAL_HOUR

def should_flash(t):
    return (t.second % 2) == 0

def get_background(category):
    return BACKGROUNDS.get(category, "#1a1a2e")

def render_mystery_mode(animal):
    bg = get_background(animal["category"])
    hint_text = "I'm a " + animal["category"] + "!"

    return render.Root(
        delay = ANIMATION_DELAY,
        child = render.Box(
            color = bg,
            child = render.Column(
                expanded = True,
                main_align = "space_between",
                cross_align = "center",
                children = [
                    # Animal image (18x18 - compact to show all text)
                    render.Image(
                        src = animal["gif"],
                        width = 18,
                        height = 18,
                    ),
                    # "Who am I?" where name goes
                    render.Text(
                        content = "Who am I?",
                        font = "CG-pixel-3x5-mono",  # Same font as name
                        color = "#FFFF00",  # Yellow
                    ),
                    # Scrolling category hint
                    render.Marquee(
                        width = 64,
                        child = render.Text(
                            content = hint_text + "     ",
                            font = "tom-thumb",
                            color = "#FFFFFF",
                        ),
                    ),
                ],
            ),
        ),
    )

def render_reveal_mode(animal, _flash_on):
    bg = get_background(animal["category"])

    # Scrolling fact and habitat
    fact_text = animal["fact"] + " - " + animal["habitat"]

    return render.Root(
        delay = ANIMATION_DELAY,
        child = render.Box(
            color = bg,
            child = render.Column(
                expanded = True,
                main_align = "space_between",
                cross_align = "center",
                children = [
                    # Animal image (18x18 - compact to show all text)
                    render.Image(
                        src = animal["gif"],
                        width = 18,
                        height = 18,
                    ),
                    # Animal name - slightly larger font
                    render.Text(
                        content = animal["name"],
                        font = "CG-pixel-3x5-mono",  # Slightly larger than fact
                        color = animal["color"],
                    ),
                    # Scrolling fact - smallest
                    render.Marquee(
                        width = 64,
                        child = render.Text(
                            content = fact_text + "     ",
                            font = "tom-thumb",  # Keep small for facts
                            color = "#FFFFFF",  # White for visibility
                        ),
                    ),
                ],
            ),
        ),
    )

def main(config):
    location = config.get("location")
    loc = json.decode(location) if location else {}
    timezone = loc.get("timezone", "America/New_York")

    now = time.now().in_location(timezone)
    day = get_day_of_year(now)
    year = now.year
    hour = now.hour
    animal = get_animal_for_day(day, year)
    if is_reveal_time(hour):
        flash = should_flash(now)
        return render_reveal_mode(animal, flash)
    else:
        return render_mystery_mode(animal)

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.Location(
                id = "location",
                name = "Location",
                desc = "Location for which to display time.",
                icon = "locationDot",
            ),
        ],
    )
