"""
Applet: Bunco Facts
Summary: 101 random Bunco facts
Description: A rotating collection of Bunco facts, common rules, and dice probabilities.
Author: Dendrdd
"""

load("render.star", "render")
load("random.star", "random")

# Tidbyt Gen 1 display: 64 x 32 pixels.
# Select a new fact every 15 seconds.
