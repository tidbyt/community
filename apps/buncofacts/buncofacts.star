def main(config):
    index = random.number(0, len(FACTS))
    fact = FACTS[index]

    return render.Root(
        delay = 15000,
        child = render.Box(
            width = 64,
            height = 32,
            color = "#000000",
            child = render.Column(
                expanded = True,
                main_align = "space_around",
                cross_align = "center",
                children = [
                    render.Text(
                        content = "BUNCO 101",
                        font = "tb-8",
                        color = "#FFB000",
                    ),
                    render.Box(
                        width = 48,
                        height = 1,
                        color = "#00D9D9",
                    ),
                    render.WrappedText(
                        content = fact,
                        font = "tb-8",
                        width = 60,
                        height = 20,
                        color = "#FFFFFF",
                        align = "center",
                    ),
                ],
            ),
        ),
    )
