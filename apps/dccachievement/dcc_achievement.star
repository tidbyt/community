"""
Applet: DCC Achievement
Summary: Shows DCC achievements
Description: Displays a new achievement from Dungeon Crawler Carl (DCC) every day. Achievements courtesy of the Dungeon Crawler Carl book series. Use the scroll speed options to fit your Tidbyt.
Author: Chase Rydeen
"""

load("encoding/base64.star", "base64")
load("render.star", "render")
load("schema.star", "schema")
load("time.star", "time")

DCC_ICON = base64.decode("""""")
DCC_ACHIEVEMENTS_URL = "https://www.chaserydeen.com/api/dcc-achievements.json"

def main(config):
    now_seconds = time.now().unix
    current_day_index = now_seconds // 86400

    FONT_SIZE = "tb-8"
    SCROLL_SPEED = config.str("scroll_speed", "100")

    all_achievements = [{"name": "Crazy Cat Lady", "desc": "You have entered the World Dungeon accompanied by a cat."}, {"name": "Trailblazing Crazy Cat Lady", "desc": "You are the first crawler to have entered to the World Dungeon accompanied by a cat."}, {"name": "Early Adopter", "desc": "You are one of the first 5,000 Crawlers to enter a new World Dungeon."}, {"name": "Empty Pockets", "desc": "You didn't bring any supplies."}, {"name": "Why Aren't You Wearing Pants?", "desc": "You entered the dungeon wearing no pants."}, {"name": "Unarmed Combat", "desc": "So."}, {"name": "Loner", "desc": "You entered the dungeon without any human companions."}, {"name": "Fall Into an Obvious Trap", "desc": "Reward: Well, if there's a heaven, and if you haven't been too much of an asshole, maybe they'll let you in."}, {"name": "You've Discovered and Read an Official Dungeon Sign", "desc": "Wow."}, {"name": "You've Inflicted Damage on a Mob", "desc": "Hopefully it won't hit back!"}, {"name": "You've Killed a Mob", "desc": "You're a murderer!"}, {"name": "You've Killed an Armed Mob With Your Bare Fucking Hands", "desc": "Holy crap, dude."}, {"name": "You've Killed a Mob a Higher Level Than Yourself", "desc": "You're getting the hang of this."}, {"name": "You've Entered a Guildhall", "desc": "Congratulations."}, {"name": "Podophilia", "desc": "You've used your bare feet to crush and kill an opponent!"}, {"name": "Boom!", "desc": "You've caused a wall-shaking explosion within the dungeon!"}, {"name": "Level-Up, Baby!", "desc": "You've received enough experience to gain a level."}, {"name": "Loot", "desc": "You're wearing something you found in the dungeon."}, {"name": "Oooh, Magic!", "desc": "You're wearing magical gear for the first time!"}, {"name": "Boss Babe", "desc": "You have struck a blow against a dungeon boss and caused damage to it."}, {"name": "You Monster!", "desc": "You have killed an infant!"}, {"name": "War Criminal", "desc": "You have killed more than 20 non-combatants in a single attack!"}, {"name": "Bitchmeat", "desc": "You've been attacked by a fellow crawler in a safe zone, and the system has been forced to save your ass."}, {"name": "Two Chicks at the Same Time", "desc": "You killed two mobs at once using only their own bodies against each other."}, {"name": "Borough Boss", "desc": "So, you've stumbled into the chamber of the second-weakest type of boss."}, {"name": "Bully and a Thief", "desc": "You've stolen property from a fellow crawler who is a lower level than you."}, {"name": "Battlefield Construction", "desc": "You built a structure and deployed it in battle."}, {"name": "This Little Piggy Went to Market!", "desc": "Oh yeah, baby."}, {"name": "You Found Stairs", "desc": "You have found a stairwell down to the next floor."}, {"name": "Wait, Bosses Can Leave Their Rooms?", "desc": "Welcome to the second floor, bitches."}, {"name": "Dungeonpreneur", "desc": "You have invented a stackable weapon, device, or potion."}, {"name": "What Goes Up...", "desc": "You have been struck with and survived the dreaded Reverse Gravity Spell."}, {"name": "Like a Moth to the Flame", "desc": "You attacked and caused damage to a mob that is more than 75 levels above your own."}, {"name": "Grease Monkey", "desc": "Don't get ahead of yourself, Dale."}, {"name": "You Call That a Trap?", "desc": "A mob has been injured because of something you purposely left lying around the dungeon."}, {"name": "I'll Take The Ceramic Dalmatian, Pat!", "desc": "You have discovered a reward room!"}, {"name": "Menagerie", "desc": "You have discovered a pet reward room."}, {"name": "PETA Enthusiast", "desc": "You somehow managed to remove the hostility of an aggravated, non-sapient enemy."}, {"name": "It's Elementary, My Dear Crawler", "desc": "And you thought all you had to do was bonk monsters on the head."}, {"name": "Meet an Elite", "desc": "Sometimes they're NPCs, sometimes they're mobs, but usually they're just assholes."}, {"name": "Lazarus", "desc": "You have been hit with—and survived—an offensive spell that was higher than level 15."}, {"name": "You Can't Fight City Hall", "desc": "But you can sure die trying."}, {"name": "One Quadrillion", "desc": "You are one of the first ten crawlers to have achieved one quadrillion views!"}, {"name": "Yellow-Bellied Chickenshit", "desc": "You initiated a boss battle, and it somehow ended with neither of you dead."}, {"name": "Johnny Quest", "desc": "Not only have you been given a quest, but you actually completed it without dying."}, {"name": "Hadji", "desc": "You have completed a quest, but you completed it in a way unusual enough to trigger the Hadji Achievement!"}, {"name": "Assassin", "desc": "You have killed a ranking NPC town official."}, {"name": "Ultimate Extreme Power", "desc": "Easy there, Charlemagne."}, {"name": "CockBlock", "desc": "You have assassinated an NPC whose existence was required to complete another crawler's quest."}, {"name": "Bandit", "desc": "Screw Hadji."}, {"name": "I'm On a Train!", "desc": "Choo Choo, Motherfucker."}, {"name": "They Like Me! They Really Like Me!", "desc": "You are one of the first five crawlers to have achieved 500 trillion followers!"}, {"name": "The Early Bird Gets To Squirm", "desc": "You went down a set of stairs more than six hours prior to the level's collapse."}, {"name": "Cuck Aquaman", "desc": "You got fucked by a fish."}, {"name": "Welcome to the Neighborhood", "desc": "You have bought a home!"}, {"name": "Well-Rested", "desc": "You managed to sleep so well that you woke up feeling refreshed and full of energy."}, {"name": "Martha Stewart", "desc": "You used a workbench to craft for the first time."}, {"name": "Locomotive Breath", "desc": "While it's not exactly a feat of engineering worthy of a Queen Elizabeth Prize, you finally managed to manufacture a train derailment."}, {"name": "Kept A Rollin'", "desc": "You're driving a train!"}, {"name": "Three Cheers for Slaughter", "desc": "You killed three boss monsters with the same attack!"}, {"name": "Mentally Unstable Clothing Hoarder", "desc": "You have over 500 of the exact same, stackable clothing item in your inventory."}, {"name": "The Quarry Sees Another Spring", "desc": "You managed to enter a stairwell while listed in the current top 10."}, {"name": "Let There Be Chaos", "desc": "You have successfully summoned a god into the dungeon."}, {"name": "Divine Epiphany", "desc": "You have seen a deity."}, {"name": "Indomitable", "desc": "You have been physically attacked by a deity, and you survived."}, {"name": "Smushed for Daddy", "desc": "You have been stepped upon by a deity."}, {"name": "Hail Mary!", "desc": "You have initiated an attack that has caused more than 100 casualties more than 100 kilometers from your current position."}, {"name": "Extinction Event", "desc": "You have, with a single attack, killed every last member of a nonunique species on a dungeon's floor."}, {"name": "Total, Utter Failure.", "desc": "You failed a quest less than five minutes after you received it."}, {"name": "Cannonball", "desc": "You fell from a great height, and you survived!"}, {"name": "You're The Reason Why Daddy Drinks", "desc": "You have, for an unspecified reason, raised the ire of the System AI."}, {"name": "Wild Goose Chase", "desc": "Oh, I'm sorry."}, {"name": "Milquetoast", "desc": "You somehow managed to win an important boss battle without actually killing the boss."}, {"name": "I Was In The Pool!", "desc": "You spent more than 60 seconds fully submerged underwater, and you didn't die!"}, {"name": "Who Let the Gods Out?", "desc": "You have allowed a feral god to enter your current realm."}, {"name": "Rock Bottom", "desc": "You dived more than 1,000 meters below the surface, and you survived!"}, {"name": "Fight the Power! (x7)", "desc": "I'm not repeating this shit over and over, but you got seven of these bad boys all at the same time."}, {"name": "Janet Jackson's Nipple", "desc": "You have been featured during a live special event."}, {"name": "Soft Vore", "desc": "You got eaten by a monster much bigger than yourself, and you managed to get out without even getting chewed a little bit."}, {"name": "Flex in the City", "desc": "You killed a city boss with the participation of five or less crawlers."}, {"name": "Man of God", "desc": "Ever since that first monkey looked up into the sky and saw something twinkling up there, you meat puppets have tried to force twenty pounds of existential meaning into a ten pound sack of chaos."}, {"name": "Disarming Personality", "desc": "You ripped a fellow crawler's arm off!"}, {"name": "I Wanna Go Home!", "desc": "You teleported to a stairwell station within the first thirty hours of the floor being open."}, {"name": "You Crossed a Line You Didn't Even Know Was There.", "desc": "You used an artifact of Divine Suffering for the first time."}, {"name": "The Hand that Claws the Master (x35)", "desc": "You have permanently killed a non-crawler biological."}, {"name": "Mass Casualty Event", "desc": "Okay."}, {"name": "Insurgent", "desc": "You left an explosive device along a well-traveled path, and it detonated and killed an intended target."}, {"name": "Double-Billed", "desc": "You are one of the first five crawlers to receive double-billing!"}, {"name": "Premature Questjaculation", "desc": "You beat a quest before I could even give it to you!"}, {"name": "Uprooted", "desc": "You caused a Rooted-in-Place boss monster to move."}, {"name": "Bisected", "desc": "You teleported into a solid object."}, {"name": "Desecrated", "desc": "You have found a desecrated temple!"}, {"name": "Temple Defiler", "desc": "You've defiled a temple's sacred shrine by breaking it with your own flesh!"}, {"name": "That's Not How You Use Arrows, Dumbass.", "desc": "You took an arrow, and you physically stabbed someone with it."}, {"name": "It itches when I pee!", "desc": "You infected another combatant with a venereal disease."}, {"name": "This Little Piggy Made a Boom Boom!", "desc": "You deployed a bomb with the supple, curved sole of your foot."}, {"name": "What Big Muscles You Have!", "desc": "Your base strength is now over 100."}, {"name": "B'sieging", "desc": "You've used siege equipment to zero in and attack a boss monster from afar."}, {"name": "Sex Pervert", "desc": "A nipple ring?"}, {"name": "Oh Shit! A Country Boss!", "desc": "You ever have one of those jobs where there's a big boss somewhere in the building, but you've never actually seen them?"}, {"name": "The Scourge", "desc": "The Butcher's Masquerade has started."}, {"name": "Marked for Life", "desc": "You were marked for death by a god."}, {"name": "Apex Predator", "desc": "Holy shit."}, {"name": "Ménage à Quatro", "desc": "You survived a four-way boss battle!"}, {"name": "Fuck This Floor", "desc": "You went down the stairs less than an hour after you arrived upon the level."}, {"name": "Pacifist", "desc": "You survived an entire floor without hurting a single, poor mob."}, {"name": "Collective Bargaining", "desc": "More than 1,000 crawlers have received the exact same box at the exact same time."}, {"name": "Fashion of the Gods", "desc": "You've received a divine item!"}, {"name": "Interloper", "desc": "You invited a red-tagged NPC boss into a saferoom, and he actually managed to get inside!"}, {"name": "Crybaby", "desc": "You've been rendered Terrified!"}, {"name": "You Have Discovered a Celestial Thorn Room", "desc": "Not a throne room."}, {"name": "Secondary Gig", "desc": "You're getting another job?"}, {"name": "\"We Want Meat! We Want Meat!\"", "desc": "Thunder Down Under."}, {"name": "The Molly Maguires", "desc": "You have found and entered the main room of a hidden guild, to which you are a member."}, {"name": "Cascadia's Turquoise Taco", "desc": "It's important to explain to you how much work it took for you to get here, to this point, Crawler."}, {"name": "Smeat", "desc": "You participated in deck combat as a minion bodyguard for a squad leader!"}, {"name": "Cliffhanger", "desc": "You scaled a cliff face with your bare hands!"}, {"name": "Prepare for Trouble", "desc": "...And make it double!"}, {"name": "LBC", "desc": "Every girl needs the perfect little black dress in her repertoire."}, {"name": "Pincushioned", "desc": "You've had both your eyeballs pierced at the same time!"}, {"name": "Watch Where You're Waving That Thing, Big Boy.", "desc": "You deployed a wand in battle and used it in a creative fashion to help kill an opponent."}, {"name": "Mass Layoffs", "desc": "Okay, so this isn't so much an achievement for you as it is for me."}, {"name": "Columbia House", "desc": "There was a time when you could get twelve albums for a penny."}, {"name": "The Fumble", "desc": "The clock is ticking down, and with everything hanging in the balance, you pulled an Earnest Byner and lost the ball at the goal line."}, {"name": "Holy Hell!", "desc": "You are in the presence of Sheol Royalty!"}, {"name": "Lord of the Flies", "desc": "Social structures are breaking down."}, {"name": "Demons Hate This One Trick", "desc": "Hey, what do you mean you can't teleport the demon-possessed?"}, {"name": "Chickenshit Exploit", "desc": "Have you ever played Dungeons and Dragons?"}, {"name": "Celestial Loot", "desc": "You're just gonna randomly pick a celestial item up off the floor?"}, {"name": "Used Pet", "desc": "People sure like to make a big deal out of adopting pets."}, {"name": "Uh oh. It Talks.", "desc": "You've discovered a sapient weapon."}, {"name": "Touched by a Demon", "desc": "You have been physically touched by a demon lord of Sheol, and you've lived to talk about it."}, {"name": "Crab Chowder", "desc": "You jerked off a crab."}, {"name": "Unbirthing", "desc": "If you still had access to Google, I would warn you not to look that one up."}, {"name": "Sushi Smoothie", "desc": "Yeah, I just made this achievement up on the fly."}, {"name": "Gavrilo Princip", "desc": "When Commander Stockade of the Lemig Sortion died a few hours back, it certainly caused a ripple or two out in the galaxy."}, {"name": "Charge of the Light Brigade", "desc": "Okay, so there are traps."}, {"name": "Varg Vikernes", "desc": "Whoa, now."}, {"name": "Liquified", "desc": "You, while immortal, blew yourself up."}, {"name": "You in My House Now, Boy!", "desc": "You have entered the temple of a god, you have pissed off that god to his face (...), and you have faced that god in battle in their own temple."}, {"name": "Celestial Orgy of Chaos", "desc": "You have been in the presence of more than ten gods at once, and you survived."}, {"name": "Hey Larry, Can I Borrow Your Chainsaw?", "desc": "You have utilized a borrowed skill or spell in battle."}, {"name": "Holistic", "desc": "Your feed has reached a 95%+ viewer ratio of a single system!"}, {"name": "You Now Tread in the Realm of Gods", "desc": "You've trained a skill past 15 using battlefield conditions, as opposed to just taking a bunch of potions to do it."}, {"name": "Executive Order 11905", "desc": "A galactic power—In this case, Prime Minister Glory himself—just attempted to assassinate you using a little known, but apparently still active control panel that allows the Syndicate to override certain showrunner-controlled aspects of the game."}, {"name": "Bombs Away", "desc": "You dropped a metric fuckton of bombs from your own inventory while you were floating in midair!"}, {"name": "Default Winner", "desc": "Wyndham Halswelle."}, {"name": "Wastrel", "desc": "Wow."}, {"name": "Come to Daddy", "desc": "You were offered an exit deal."}, {"name": "Weaseler", "desc": "You've donned the corpse of an enemy in an attempt to fool another creature!"}, {"name": "Slip-'N'-Slide", "desc": "Ungghh."}, {"name": "Brotein", "desc": "You gently caressed the nipple of a male boss in the middle of a boss battle."}, {"name": "'76 Buccaneers", "desc": "So..."}, {"name": "What the actual fuck, Carl?", "desc": "Okay, so there are power moves."}]

    achievement_index = current_day_index % len(all_achievements)
    current_achievement = all_achievements[achievement_index]

    lines = [
        "%s" % current_achievement["name"],
        "%s" % current_achievement["desc"],
    ]

    text_widgets = []
    text_widgets.append(render.Image(src = DCC_ICON))
    for line in lines:
        text_widgets.append(
            render.WrappedText(content = line, font = FONT_SIZE, color = "#fff"),
        )
        text_widgets.append(render.Box(height = 4))  # Add spacing between lines

    return render.Root(
        delay = int(SCROLL_SPEED),
        child = render.Marquee(
            height = 32,
            width = 64,
            scroll_direction = "vertical",
            offset_start = 32,
            offset_end = 32,
            child = render.Column(
                main_align = "center",
                cross_align = "center",
                children = text_widgets,
            ),
        ),
    )

def get_schema():
    scroll_speed = [
        schema.Option(display = "Slow", value = "200"),
        schema.Option(display = "Normal (Default)", value = "100"),
        schema.Option(display = "Fast", value = "60"),
        schema.Option(display = "Faster", value = "30"),
    ]
    return schema.Schema(
        version = "1",
        fields = [
            schema.Dropdown(
                id = "scroll_speed",
                name = "Scroll speed",
                desc = "Text scrolling speed",
                icon = "personRunning",
                default = scroll_speed[1].value,
                options = scroll_speed,
            ),
        ],
    )
